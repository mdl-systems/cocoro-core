# cocoro-core — 環境変数テンプレート
# cp .env.example infra/docker/.env してから編集してください

# === LLM ===
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_MODEL=gemma2:2b

# === API認証 ===
COCORO_API_KEY=cocoro-2026

# === Database ===
POSTGRES_PASSWORD=cocoro_secret

# === JWT認証 ===
# 空にするとAPI Key認証のみ
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=text

# === Webhook（任意） ===
WEBHOOK_URL=

# === Security ===
# カンマ区切りで許可IP指定。空=全IP許可
IP_WHITELIST=
# カンマ区切りでブロックIP指定。空=なし
IP_BLACKLIST=
FORCE_HTTPS=false
RATE_LIMIT_ENABLED=true
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_SECONDS=300

# === Scheduler（時間, 0=無効） ===
CONSOLIDATION_INTERVAL_HOURS=6
EMOTION_DECAY_INTERVAL_HOURS=1
SYNC_RECORD_INTERVAL_HOURS=12
OBSERVATION_REPORT_INTERVAL_HOURS=24
MEMORY_ARCHIVE_INTERVAL_HOURS=24
