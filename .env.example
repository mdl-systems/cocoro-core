# cocoro-core
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-api-key
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_MODEL=gemma2:2b
POSTGRES_PASSWORD=cocoro_secret
COCORO_API_KEY=your-api-key-here
LOG_LEVEL=INFO
WEBHOOK_URL=

# === JWT Authentication ===
JWT_SECRET=                        # 空=API Key認証にフォールバック
JWT_EXPIRE_HOURS=24

# === Security (D-10) ===
IP_WHITELIST=                      # カンマ区切り。空=全IP許可
IP_BLACKLIST=                      # カンマ区切り。空=ブロックなし
FORCE_HTTPS=false                  # 本番環境で true に
RATE_LIMIT_ENABLED=true            # Rate Limiting 有効/無効
LOGIN_MAX_FAILURES=10              # 認証失敗の許容回数
LOGIN_LOCKOUT_SECONDS=300          # ロックアウト時間(秒)
